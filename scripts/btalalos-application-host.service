[Unit]
Description=BtalaLos host CLI and desktop companion

[Service]
Type=simple
EnvironmentFile=%h/.config/btalalos-application-host.env
ExecStart=/usr/bin/env node ${DOSSIER_HOST_SCRIPT}
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillMode=control-group
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target

[Unit]
Description=Dossier application preparation worker

[Service]
Type=simple
EnvironmentFile=%h/.config/dossier-application-worker.env
ExecStart=/usr/bin/env node ${DOSSIER_WORKER_SCRIPT}
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillMode=control-group
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
